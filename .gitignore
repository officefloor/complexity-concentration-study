.venv/
__pycache__/
*.pyc
*.egg-info/

# Per-run study output written at the repo root (not committed; runs default to results/<date>/).
/study.json
/study.csv

# Generated ancillary-data packages (the paper attachment is produced per run).
/anc/

# LaTeX build intermediates (paper sources ARE committed; per-run DATA is NOT).
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/build.log

# Per-run study data is NOT committed (study.json can reach ~100MB).
# Regenerate by running the study, or use the curated subset published as the
# paper's ancillary data. Readers who want all the data run the project themselves.
paper/data/
/results/

# Downloaded (non-pip) dependencies: PMD and CK, fetched into ./lib by `setup.sh`
# (complexity-concentration-study deps), verified against their pinned sha256. Not committed -- every
# machine downloads the exact pinned artifacts itself.
/lib/

# Blog drafts for blog.officefloor.net (paste-ready Blogger HTML and its Markdown source).
/blog/

# The paper's figure virtualenv and build products (main.tex, generated/ and figures/ ARE tracked).
paper/.venv/
paper/main.pdf
paper/abstract.txt
paper/arxiv.tar.gz
paper/build.log

# Step 5's MLCQ working directory (regenerated by step5_mlcq.sh, digests in mlcq-hashes.txt) and the
# step logs; the derived label files ship in the paper's ancillary bundle.
/labels/
/step*.log
